# Copy to pi/.env, then chmod 600 pi/.env (POSIX).
# The Figma CLI loads this worktree's pi/.env automatically, from any cwd.
# Enter credentials in your editor/terminal, never in pi chat or Git.

# Required: personal access token with file_content:read and access to the file.
FIGMA_TOKEN=

# Optional alternative: leave FIGMA_TOKEN empty and point to a private token file.
# Use an absolute path, ~/..., or a path relative to this pi/ directory.
# FIGMA_TOKEN_FILE=~/.config/pi-figma/token
