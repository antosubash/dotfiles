[Unit]
Description=Headless Pi GitHub issue worker supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/pi-issue-worker-supervisor --config-dir %h/.config/pi-issue-worker
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/pi-issue-worker %h/.cache

[Install]
WantedBy=default.target
