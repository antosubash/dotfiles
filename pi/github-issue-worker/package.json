{
  "name": "@pi-tools/github-issue-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable headless Pi worker that turns approved GitHub issues into draft pull requests.",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pi-issue-worker": "dist/src/index.js",
    "pi-issue-worker-supervisor": "dist/src/supervisor.js"
  },
  "files": [
    "dist/src",
    "README.md",
    ".env.example",
    "docs",
    "systemd"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "dev": "tsx src/index.ts --once",
    "prepack": "npm run build",
    "start": "node dist/src/index.js",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.73",
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
