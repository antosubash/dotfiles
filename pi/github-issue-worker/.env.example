# Required repository settings. Use one profile per repository; the supervisor can run many profiles.
PI_WORKER_REPOSITORY=owner/repository
PI_WORKER_REPOSITORY_URL=https://github.com/owner/repository.git
PI_WORKER_BASE_BRANCH=main

# Labels are created automatically. Override individual labels when needed.
PI_WORKER_LABEL_PREFIX=pi
# PI_WORKER_READY_LABEL=pi-ready
# PI_WORKER_VISUAL_LABEL=pi-visual

# Runtime state. The default includes a repository identity hash to prevent collisions.
# PI_WORKER_DATA_DIR=~/.local/share/pi-issue-worker/owner-repository-<identity-hash>
PI_WORKER_POLL_SECONDS=60
PI_WORKER_MODEL=openai-codex/gpt-5.6-terra
PI_WORKER_THINKING_LEVEL=high
PI_WORKER_MAX_ISSUES_PER_POLL=1
# Maximum automatic repair pushes across successive failed PR heads.
PI_WORKER_MAX_CI_FIX_ATTEMPTS=3
# Hard ceiling for one Pi SDK run. Final agent_settled events also have a short prompt watchdog.
PI_WORKER_AGENT_TIMEOUT_MINUTES=60

# Only feedback from these GitHub author associations is accepted.
PI_WORKER_TRUSTED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR

# Comma-separated paths the agent may not modify. Paths are repository-relative.
PI_WORKER_PROTECTED_PATHS=.git,.github/workflows,.pi,.pi-worker

# Optional strict repository QA manifest. Missing files are allowed; malformed or symlinked files fail closed.
# The repository-relative default is .pi-worker/qa.json.
# PI_WORKER_QA_MANIFEST=.pi-worker/qa.json

# Optional browser-verification inputs. Artifacts always remain ignored under .qa/.
PI_WORKER_APP_URL=http://localhost:3000
# Optional additional sandbox network hosts for builds/browser verification.
# PI_WORKER_SANDBOX_ALLOWED_DOMAINS=internal.example.com,cdn.example.com
PI_WORKER_PLAYWRIGHT_STATE=~/.config/pi-issue-worker/storage-state.json
PI_WORKER_QA_RETENTION_DAYS=14

# Docker is automatically available to agent runs when this socket exists. Set 0 to disable it.
# Docker daemon access defeats normal sandbox isolation; use a dedicated disposable worker host.
# PI_WORKER_ALLOW_DOCKER=0
# PI_WORKER_DOCKER_SOCKET=/var/run/docker.sock

# Generated PNG/GIF/WebM QA evidence is signature-checked and published to this orphan branch so
# PR comments can embed it. Set PI_WORKER_PUBLISH_EVIDENCE=0 to keep evidence local only.
PI_WORKER_PUBLISH_EVIDENCE=1
PI_WORKER_EVIDENCE_BRANCH=pi-evidence

# Optional Pi config override. Defaults to ~/.pi/agent.
# PI_CODING_AGENT_DIR=~/.pi/agent

# gh uses GH_TOKEN when set, otherwise its authenticated keyring account.
# Prefer a dedicated GitHub App or machine-user token in production.
# GH_TOKEN=
